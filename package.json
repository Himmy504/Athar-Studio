{
  "name": "athar-studio",
  "version": "0.3.0",
  "private": true,
  "description": "A Windows editor for reviewed Arabic-to-English captioned clips",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "predev": "npm run prepare:assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "check:repo": "node scripts/check-repository.mjs",
    "check": "npm run check:repo && npm test && npm run build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "beta:prepare": "node scripts/prepare-beta.mjs",
    "beta:check": "node scripts/prepare-beta.mjs --check"
  },
  "dependencies": {
    "@fontsource/amiri": "5.3.0",
    "@fontsource/cairo": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/lato": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/markazi-text": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/noto-kufi-arabic": "5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.2.5",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/reem-kufi": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/scheherazade-new": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "libass-wasm": "4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "wawoff2": "^2.0.1"
  }
}
